@tokens {
  space { @whitespace+ }

  Comment { "//" ![\n]* }

  word { $[a-zA-Z_] $[a-zA-Z_0-9#]* }

  number { $[0-9]+ ("." $[0-9]+)? }

  stringDelimiter { "\"" }
  stringEscape { "\\" $[.] }
  stringContent { !["\\{\r\n] }

  "~["
  "[" "]"
  "<" ">"
  "{" "}"
  "(" ")"
  ","
  "."

  "="
  ":"

  "+"
  "-"
  "*"
  "/"

  "&"
  "@"

  "!"
  "?"

  "=="
  "!="
  ">="
  "<="

  @precedence { Comment, "/" }
}

@skip { space | Comment }

@detectDelim

kw<term> { @specialize[@name=keyword]<word, term> }
unit<term> { @extend[@name=unit]<word, term> }

Unit[@dynamicPrecedence=1] {
  unit<"bpm"> |
  unit<"db"> |
  unit<"hz"> |
  unit<"s"> |
  unit<"ms"> |
  unit<"bar"> |
  unit<"bars"> |
  unit<"beat"> |
  unit<"beats">
}

@precedence {
  unaryPlusMinus @right,
  unaryNot @right,
  multiply @left,
  plus @left,
  comparison @left,
  conjunction @left,
  disjunction @left,
  capability @right
}

@top Program {
  (Import | statement)*
}

VariableDefinition { word }
VariableName { word }

Boolean { kw<"true"> | kw<"false"> }

Number { number }

@skip {} {
  String {
    stringDelimiter
    (stringEscape | stringContent | interpolationExpression)*
    stringDelimiter
  }
}

interpolationExpression {
  "{"
  expression
  "}"
}

Pattern { serialPattern }

serialPattern {
  "["
  (step | serialPattern | parallelPattern | interpolationExpression)*
  "]"
}

parallelPattern {
  "<"
  (step | serialPattern | parallelPattern | interpolationExpression)*
  ">"
}

step {
  (word | "-")
  argumentList?
  (":" AccessOrCall)?
}

Curve {
  "~["
  (curveSegment | interpolationExpression)*
  "]"
}

curveSegment {
  CurveSegmentShape { word }
  argumentList?
  (":" AccessOrCall)?
}

argumentList {
  "("
  (argument ("," argument)*)?
  ")"
}

argument {
  (ArgumentName { word } ":")?
  expression
}

parameterList {
  "("
  (parameter ("," parameter)*)?
  ")"
}

parameter {
  VariableDefinition "?"? ":" Type
}

Type {
  atomicType ("+" atomicType)*
}

atomicType {
  NamedType | FunctionType | RecordType | ("(" Type ")")
}

NamedType {
  word ("." word)*
}

FunctionType {
  parameterList
  ":"
  atomicType
  (!capability "!" Capability { word })*
}

RecordType {
  "{"
  (recordTypeProperty ("," recordTypeProperty)*)?
  "}"
}

recordTypeProperty {
  VariableDefinition ":" Type
}

Import {
  kw<"use"> String
  kw<"as"> UseAlias { word | "*" }
}

statement {
  simpleStatement | compoundStatement
}

simpleStatement {
  Assignment | Emission | EmissionAssignment
}

Assignment {
  "@"?
  VariableDefinition
  "="
  expression
}

Emission {
  "&"
  expression
  ("," expression)*
}

EmissionAssignment {
  "&"
  Assignment
}

compoundStatement {
  IfStatement
}

IfStatement {
  kw<"if">
  expression Block
  ("," expression Block)*
  ("," kw<"else"> Block)?
}

primary {
  "(" expression ")" |
  Call |
  VariableName |
  Boolean |
  Number |
  String |
  Function |
  Record |
  Curve |
  Pattern |
  Builder<"bus"> |
  Builder<"instrument"> |
  Builder<"mixer"> |
  Builder<"part"> |
  Builder<"track"> |
  Voice
}

expression {
  AccessOrCall | UnaryExpression | BinaryExpression
}

AccessOrCall {
  primary
  (
    "." Call |
    "." Member { Unit | word }
  )*
}

Call {
  Callee { word }
  argumentList
}

UnaryExpression {
  (!unaryPlusMinus "+" expression) |
  (!unaryPlusMinus "-" expression) |
  (!unaryNot kw<"not"> expression)
}

BinaryExpression {
  (expression !plus "+" expression) |
  (expression !plus "-" expression) |
  (expression !multiply "*" expression) |
  (expression !multiply "/" expression) |
  (expression !comparison "==" expression) |
  (expression !comparison "!=" expression) |
  (expression !comparison ">" expression) |
  (expression !comparison "<" expression) |
  (expression !comparison ">=" expression) |
  (expression !comparison "<=" expression) |
  (expression !conjunction kw<"and"> expression) |
  (expression !disjunction kw<"or"> expression)
}

Function {
  parameterList
  FunctionBody
}

FunctionBody {
  "{" statement* "}"
}

Record {
  Block
}

Block {
  "{" statement* "}"
}

Builder<term> {
  kw<term>
  argumentList?
  Block
}

Voice {
  kw<"voice">
  VariableDefinition?
  FunctionBody
}
