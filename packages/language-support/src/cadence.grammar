@tokens {
  space { @whitespace+ }

  Comment { "//" ![\n]* }

  word { $[a-zA-Z_] $[a-zA-Z_0-9#]* }

  number { $[0-9]+ ("." $[0-9]+)? }

  stringDelimiter { "\"" }
  stringEscape { "\\" $[.] }
  stringContent { !["\\{\r\n] }

  "~["
  "[" "]"
  "<" ">"
  "{" "}"
  "(" ")"
  ","
  "."

  "="
  ":"

  "+"
  "-"
  "*"
  "/"

  "&"
  "@"

  "!"

  @precedence { Comment, "/" }
}

@skip { space | Comment }

@detectDelim

kw<term> { @specialize[@name=keyword]<word, term> }
unit<term> { @extend[@name=unit]<word, term> }

Unit[@dynamicPrecedence=1] {
  unit<"bpm"> |
  unit<"db"> |
  unit<"hz"> |
  unit<"s"> |
  unit<"ms"> |
  unit<"bar"> |
  unit<"bars"> |
  unit<"beat"> |
  unit<"beats">
}

@precedence {
  multiply @left,
  plus @left,
  capability @right
}

@top Program {
  (Import | statement)*
}

interpolationExpression {
  "{"
  expression
  "}"
}

VariableDefinition { word }
VariableName { word }

Boolean { kw<"true"> | kw<"false"> }

Number { number }

@skip {} {
  String {
    stringDelimiter
    (stringEscape | stringContent | interpolationExpression)*
    stringDelimiter
  }
}

Pattern { serialPattern }

serialPattern {
  "["
  (step | serialPattern | parallelPattern | interpolationExpression)*
  "]"
}

parallelPattern {
  "<"
  (step | serialPattern | parallelPattern | interpolationExpression)*
  ">"
}

step {
  (word | "-") ("(" argumentList? ")")? (":" AccessOrCall)?
}

Curve {
  "~["
  (curveSegment | interpolationExpression)*
  "]"
}

curveSegment {
  CurveSegmentShape { word } ("(" argumentList? ")")? (":" AccessOrCall)?
}

argumentList {
  argument ("," argument)*
}

argument {
  (ArgumentName { word } ":")?
  expression
}

parameterList {
  parameter ("," parameter)*
}

parameter {
  VariableDefinition ":" Type
}

Type {
  atomicType ("+" atomicType)*
}

atomicType {
  NamedType | FunctionType | RecordType | ("(" Type ")")
}

NamedType {
  word ("." word)*
}

FunctionType {
  "(" parameterList? ")"
  ":"
  atomicType
  (!capability "!" Capability { word })*
}

RecordType {
  "{" parameterList? "}"
}

primary {
  "(" expression ")" |
  Call |
  VariableName |
  Boolean |
  Number |
  String |
  Function |
  Record |
  Bus |
  Curve |
  Instrument |
  Mixer |
  Part |
  Pattern |
  Track |
  Voice
}

Call {
  Callee { word }
  "(" argumentList? ")"
}

AccessOrCall {
  primary
  (
    "." Call |
    "." Member { Unit | word }
  )*
}

expression {
  AccessOrCall | UnaryExpression | BinaryExpression
}

UnaryExpression {
  ("+" | "-") expression
}

BinaryExpression {
  (expression !plus "+" expression) |
  (expression !plus "-" expression) |
  (expression !multiply "*" expression) |
  (expression !multiply "/" expression)
}

Import {
  kw<"use"> String
  kw<"as"> UseAlias { word | "*" }
}

Assignment {
  "@"?
  VariableDefinition
  "="
  expression
}

Emission {
  "&"
  expression
  ("," expression)*
}

EmissionAssignment {
  "&"
  Assignment
}

statement {
  Assignment | Emission | EmissionAssignment
}

Function {
  "(" parameterList? ")"
  FunctionBlock[group=Block] {
    "{" statement* "}"
  }
}

Record {
  "{" statement* "}"
}

Track {
  kw<"track">
  ("(" argumentList? ")")?
  TrackBlock[group=Block] {
    "{" statement* "}"
  }
}

Part {
  kw<"part">
  PartName { word }?
  ("(" argumentList? ")")?
  PartBlock[group=Block] {
    "{" statement* "}"
  }
}

Mixer {
  kw<"mixer">
  ("(" argumentList? ")")?
  MixerBlock[group=Block] {
    "{" statement* "}"
  }
}

Bus {
  kw<"bus">
  BusName { word }?
  ("(" argumentList? ")")?
  BusBlock[group=Block] {
    "{" statement* "}"
  }
}

Instrument {
  kw<"instrument">
  InstrumentBlock[group=Block] {
    "{" statement* "}"
  }
}

Voice {
  kw<"voice">
  VariableDefinition?
  VoiceBlock[group=Block] {
    "{" statement* "}"
  }
}
